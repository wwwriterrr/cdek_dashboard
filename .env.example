# Скопируйте в .env.local и заполните под себя. .env.local в git не попадает.

# Куда проксировать /api и /media в режиме разработки.
VITE_API_TARGET=https://alterlit.ru

# Префикс, с которого бэкенд отдаёт статику панели.
VITE_STATIC_BASE=/assets/books/dashboard/

# Необязательно. Куки для локальной разработки, чтобы не логиниться через
# localhost. Нужны обе: сессия и CSRF-токен, иначе PATCH-запросы не пройдут.
# Формат: alterlitsessionid=<значение>; csrftoken=<значение>
#
# Прокси сам достанет отсюда csrftoken и подставит его в заголовок X-CSRFToken,
# а заодно перепишет Referer — Django на HTTPS его проверяет.
#
# Это рабочая сессия администратора — не коммитьте её и не передавайте дальше.
VITE_DEV_COOKIE=

# Мок создания заказа в СДЭК (POST /api/v1/cdek/orders/<id>/), только для dev.
# Заказы в таблице боевые — без мока кнопка создала бы настоящую отправку.
#   cycle (по умолчанию) — сценарий по номеру заказа: id % 6
#   ok | cdek_error | details_list | cdek_down | forbidden | html_500 — всегда этот
#   off — мок выключен, запрос уйдёт на настоящий бэк
VITE_CDEK_MOCK=cycle
